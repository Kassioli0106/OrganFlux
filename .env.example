# Copie para .env e preencha para rodar localmente com `netlify dev`.
# Em produção, configure estas variáveis em Netlify → Site settings → Environment variables.

# Chave da API da Anthropic (console.anthropic.com) — usada pelas functions de IA.
ANTHROPIC_API_KEY=

# Preenchida automaticamente pela integração "Netlify DB" (Neon) quando você
# rodar `netlify db init` ou ativar a integração no painel do site.
# Se preferir usar seu próprio Postgres, defina DATABASE_URL manualmente.
NETLIFY_DATABASE_URL=
